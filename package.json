{
  "name": "coronium-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Coronium agent-native interfaces — CLI, MCP server, TypeScript SDK.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build",
    "test": "pnpm -r build && vitest run",
    "test:watch": "vitest",
    "dev:api": "pnpm -F coronium-mock-api dev",
    "doctor": "node scripts/doctor.mjs",
    "publish:dry": "pnpm doctor && pnpm -r --filter './packages/**' publish --dry-run --access public --no-git-checks",
    "publish:alpha": "pnpm doctor && pnpm -r --filter './packages/**' publish --tag alpha --access public"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
