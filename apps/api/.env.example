# Coronium API — environment variables
# Copy to .env and fill in for local dev. NEVER commit .env.

# ─── Server ──────────────────────────────────────────────────────────────
PORT=5050
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────
# SQLite path. ":memory:" for ephemeral (tests). Absolute path for prod.
DATABASE_PATH=./data/coronium.db

# ─── cor-api-v1 (legacy / system of record) ──────────────────────────────
# The existing Coronium API. We call it for actual modem ops, payment state.
# In prod this is api.coronium.io/api/agent (Lauren's agent endpoint).
UPSTREAM_API_URL=https://api.coronium.io/api/agent

# Bearer token for the upstream agent API. Service-to-service.
# Rotate via the existing admin tools when leaked.
UPSTREAM_API_TOKEN=

# ─── Spend caps (defaults; per-key overrides live in DB) ─────────────────
DEFAULT_DAILY_CAP_USD=50
DEFAULT_SESSION_CAP_USD=5
TENANT_DAILY_CAP_USD=500

# ─── Rate limiting ───────────────────────────────────────────────────────
RATE_LIMIT_PER_KEY_PER_MIN=120
RATE_LIMIT_PER_IP_PER_MIN=60

# ─── CORS ────────────────────────────────────────────────────────────────
# Comma-separated. * is allowed but not recommended in prod.
CORS_ORIGINS=https://coronium.ai,https://dashboard.coronium.io

# ─── Trial credit on signup ──────────────────────────────────────────────
TRIAL_CREDIT_USD=0.50
