{
  "name": "@coronium/mock-api",
  "version": "0.0.0",
  "private": true,
  "description": "Tiny Express mock server implementing coronium-ai/openapi.yaml — for local CLI/MCP/SDK testing.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "4.21.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.14.10",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
