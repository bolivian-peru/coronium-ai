{
  "name": "coronium-api",
  "version": "0.1.0",
  "private": true,
  "description": "Coronium agent-native API — production server implementing openapi.yaml. Deploys to api.coronium.ai.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/scripts/migrate.js",
    "migrate:dev": "tsx src/scripts/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/sensible": "6.0.1",
    "fastify-plugin": "5.0.1",
    "better-sqlite3": "11.7.0",
    "dotenv": "16.4.5",
    "fastify": "5.1.0",
    "pino": "9.5.0",
    "pino-pretty": "13.0.0",
    "siwe": "2.3.2",
    "undici": "7.0.0",
    "viem": "2.21.55",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "20.14.10",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
