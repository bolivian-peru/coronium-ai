{
  "name": "coronium-cli",
  "version": "0.1.0-alpha.0",
  "description": "Coronium CLI — buy and manage mobile (4G/5G) proxies from your shell.",
  "license": "Apache-2.0",
  "keywords": [
    "coronium",
    "proxy",
    "mobile-proxy",
    "4g",
    "5g",
    "cli"
  ],
  "homepage": "https://github.com/bolivian-peru/coronium-ai/tree/main/packages/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/bolivian-peru/coronium-ai.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/bolivian-peru/coronium-ai/issues"
  },
  "type": "module",
  "bin": {
    "coronium": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "dependencies": {
    "coronium-sdk": "workspace:*",
    "commander": "12.1.0",
    "kleur": "4.1.5",
    "prompts": "2.4.2",
    "smol-toml": "1.3.1",
    "viem": "2.21.55"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/prompts": "2.4.9",
    "typescript": "5.7.2"
  }
}
