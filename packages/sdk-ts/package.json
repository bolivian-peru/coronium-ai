{
  "name": "coronium-sdk",
  "version": "0.2.0-beta.1",
  "description": "Typed TypeScript client for the Coronium mobile-proxy API.",
  "license": "Apache-2.0",
  "keywords": [
    "coronium",
    "proxy",
    "mobile-proxy",
    "4g",
    "5g",
    "agent",
    "ai",
    "sdk"
  ],
  "homepage": "https://github.com/bolivian-peru/coronium-ai/tree/main/packages/sdk-ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/bolivian-peru/coronium-ai.git",
    "directory": "packages/sdk-ts"
  },
  "bugs": {
    "url": "https://github.com/bolivian-peru/coronium-ai/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "typescript": "5.7.2"
  }
}
